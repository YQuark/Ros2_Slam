<?xml version="1.0"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.3.0</version>
  <description>System bringup orchestration for platform, mapping and navigation profiles.</description>
  <maintainer email="robot@example.com">robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_description</exec_depend>
  <exec_depend>robot_sensing</exec_depend>
  <exec_depend>robot_control</exec_depend>
  <exec_depend>robot_state_estimation</exec_depend>
  <exec_depend>stm32_robot_bridge</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
